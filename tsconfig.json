{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "vitest/globals"
    ],
    "skipLibCheck": true
  },
  "include": [
    "shared/**/*.ts",
    "tests/**/*.ts"
  ]
}
