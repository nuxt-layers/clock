{
  "name": "@nuxt-layers/clock",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Headless date/time foundation for Nuxt",
  "license": "MIT",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26.13.0"
  },
  "exports": {
    ".": "./nuxt.config.ts",
    "./core": "./shared/core.ts",
    "./server": "./server/index.ts"
  },
  "scripts": {
    "test": "vitest run tests/core.test.ts tests/interchange.test.ts tests/pattern-additions.test.ts tests/runtime-assumptions.test.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:host": "pnpm --dir examples/minimal-host typecheck"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "^4.0.0",
    "nuxt": "^4.6.0"
  },
  "peerDependencies": {
    "nuxt": "^4.6.0"
  }
}
